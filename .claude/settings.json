{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "enabledPlugins": {
        "claude-security@claude-plugins-official": true,
        "superpowers@claude-plugins-official": true,
        "claude-code-setup@claude-plugins-official": true,
        "caveman@akramsystems-plugins": true
    },
    "extraKnownMarketplaces": {
        "akramsystems-plugins": {
            "source": {
                "source": "github",
                "repo": "akramsystems/caveman"
            }
        }
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Write|Edit|mcp__serena__(replace_content|replace_symbol_body|insert_after_symbol|insert_before_symbol|rename_symbol|safe_delete_symbol|replace_in_files)",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/architecture-sync.mjs\"",
                        "shell": "bash",
                        "timeout": 10,
                        "statusMessage": "Checking ARCHITECTURE.md sync"
                    },
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/docs-sync.mjs\"",
                        "shell": "bash",
                        "timeout": 10,
                        "statusMessage": "Checking module docs and training guides"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/docs-sync.mjs\"",
                        "shell": "bash",
                        "timeout": 10,
                        "statusMessage": "Checking module docs and training guides"
                    }
                ]
            }
        ]
    }
}
